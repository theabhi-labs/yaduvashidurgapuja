# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://kapooripur.in,https://www.kapooripur.in,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE & AUTHENTICATION (MANDATORY)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/durgapuja?retryWrites=true&w=majority

# Strong Random JWT Secret
JWT_SECRET=your_super_secret_jwt_random_key_yaduvanshi_2026_kapooripur
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
CONTACT_EMAIL=contact@kapooripur.in

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (FOR PHOTOS & MEMORIES)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kapooripur-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 4. BREVO (TRANSACTIONAL EMAILS, OTP & PASSWORD RESET)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=contact@kapooripur.in
BREVO_SENDER_NAME=Yaduvanshi Durga Puja Kapooripur

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (DONATION & SEVA)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret

# ------------------------------------------------------------------------------
# 6. LIVEKIT WEBRTC (LIVE DARSHAN & MAHA AARTI BROADCAST)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://durgapuja-xxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. REDIS (EPHEMERAL LIVE CHAT & CACHING - OPTIONAL)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:xxxxxxxx@xxxxxx.upstash.io:6379
